{
  "name": "amazon-order-options",
  "version": "1.0.0",
  "description": "Browser extension and userscript that shows the size, color and other selected options for items on Amazon order and return pages.",
  "private": true,
  "type": "module",
  "author": "Kyle Barkmeier",
  "license": "MIT",
  "homepage": "https://github.com/kylebarkmeier/amazon-order-options",
  "repository": {
    "type": "git",
    "url": "https://github.com/kylebarkmeier/amazon-order-options.git"
  },
  "bugs": {
    "url": "https://github.com/kylebarkmeier/amazon-order-options/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs chrome",
    "build:firefox": "node scripts/build.mjs firefox",
    "build:userscript": "node scripts/build.mjs userscript",
    "package": "npm run build && node scripts/package.mjs",
    "icons": "node scripts/make-icons.mjs",
    "lint": "eslint .",
    "lint:webext": "node scripts/lint-firefox.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium firefox webkit",
    "icons:check": "npm run icons && git diff --exit-code -- src/icons",
    "check": "npm run lint && npm run test:unit && npm run package && npm run lint:webext && npm run icons:check && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@vitest/coverage-v8": "5.0.5",
    "addons-linter": "10.14.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "vitest": "5.0.5"
  }
}
